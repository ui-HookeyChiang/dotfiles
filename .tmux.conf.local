# ~/.tmux.conf.local — user-owned override for oh-my-tmux.
# install.sh symlinks this file to ~/.config/tmux/.tmux.conf.local (the path
# oh-my-tmux loads). Edit only this repo copy.
#
# Format: tmux_conf_* assignments configure the theme (read by oh-my-tmux's
# _apply_configuration). set/bind overrides need #!important so they survive
# that pass — see oh-my-tmux README and docs/specs/done/2026-05-15-tmux-conf-local-routing-and-vim-tmux-navigator.md.

# -- theme (powerline — matches p10k POWERLEVEL9K_MODE=powerline / MesloLGS NF) -
# Requires a Nerd Font or Powerline-patched font in the terminal (same as p10k).
tmux_conf_theme_left_separator_main='\uE0B0'
tmux_conf_theme_left_separator_sub='\uE0B1'
tmux_conf_theme_right_separator_main='\uE0B2'
tmux_conf_theme_right_separator_sub='\uE0B3'
# OFF indicator prepended while F12 keys-off toggle is active (outer tmux only).
tmux_conf_theme_status_right='#{?#{==:#{client_key_table},off},OFF ,} #{prefix}#{mouse}#{pairing}#{synchronized}#{?battery_status, #{battery_status},}#{?battery_bar, #{battery_bar},}#{?battery_percentage, #{battery_percentage},} , %R , %d %b | #{username}#{root} | #{hostname} '

# -- clipboard ----------------------------------------------------------------
if-shell 'command -v pbcopy >/dev/null 2>&1' \
    "set -gq @copy_use_osc52_fallback off ; \
     bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'pbcopy' ; \
     bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'pbcopy'"

if-shell 'command -v xclip >/dev/null 2>&1 && [ -z "${SSH_CONNECTION:-}" ] && [ -n "${DISPLAY:-}" ]' \
    "bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel 'xclip -in -selection clipboard' ; \
     bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel 'xclip -in -selection clipboard'"

set -gq set-clipboard on #!important
set -ag terminal-features ",tmux-256color:clipboard" #!important
set -ag terminal-features ",xterm-256color:clipboard" #!important

set -g mouse on #!important
bind-key -T root MouseDrag1Pane if-shell -F '#{pane_in_mode}' 'send-keys -M' 'copy-mode -M' #!important

bind-key -n C-h if-shell -F '#{@is_vim}' 'send-keys C-h' 'select-pane -L' #!important
bind-key -n C-j if-shell -F '#{@is_vim}' 'send-keys C-j' 'select-pane -D' #!important
bind-key -n C-k if-shell -F '#{@is_vim}' 'send-keys C-k' 'select-pane -U' #!important
bind-key -n C-l if-shell -F '#{@is_vim}' 'send-keys C-l' 'select-pane -R' #!important
bind-key -T copy-mode-vi C-h select-pane -L #!important
bind-key -T copy-mode-vi C-j select-pane -D #!important
bind-key -T copy-mode-vi C-k select-pane -U #!important
bind-key -T copy-mode-vi C-l select-pane -R #!important

set -g history-limit 50000 #!important
set -g default-terminal "tmux-256color" #!important
set -ag terminal-overrides ",xterm-256color:RGB" #!important
set -g allow-passthrough on #!important

if-shell '[ -z "${SSH_CONNECTION:-}" ]' \
    "bind-key -T root F12 set prefix None \\; set key-table off \\; refresh-client -S ; \
     bind-key -T off F12 set -u prefix \\; set -u key-table \\; refresh-client -S"

bind C-b send-prefix #!important
