{
  "name": "flow-dev-handoff-contract",
  "version": 1,
  "description": "Narrow contract for flow Stage 4 dispatch into flow-dev.",
  "input": {
    "required_fields": [
      "task_source",
      "feature_prefix",
      "default_branch",
      "tasks",
      "gates"
    ],
    "task_source": [
      "ticket_list",
      "direct_grounded_task"
    ],
    "task_required_fields": [
      "description",
      "test_plan",
      "issue_path"
    ],
    "gates": {
      "required_fields": [
        "satisfied",
        "delegated"
      ],
      "known": [
        "converge",
        "spec",
        "decompose",
        "dev",
        "fan_in",
        "integration"
      ]
    }
  },
  "output": {
    "required_fields": [
      "per_task_status",
      "failed_tasks",
      "tests_run",
      "completion_summary"
    ],
    "per_task_status_values": [
      "pass",
      "fail"
    ]
  }
}
